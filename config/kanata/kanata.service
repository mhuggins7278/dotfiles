[Unit]
Description=Kanata advanced keyboard remapper (omarchy home-row mods)
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/bin/kanata -c /home/mdh/.config/kanata/omarchy.kbd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
