#!/usr/bin/env bash
# agent-review — Spawn an opencode review session for a GitHub PR
# Usage: agent-review <pr_number> <repo_name> <repo_path>
#
# Reviews an exact PR head in an isolated Worktrunk sibling and removes it only
# after a successful OpenCode session. Failed sessions stay open for diagnosis.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SESSION_RUNNER="$SCRIPT_DIR/agent-review-session"

if [ "$#" -ne 3 ]; then
  echo "Usage: agent-review <pr_number> <repo_name> <repo_path>" >&2
  exit 2
fi

PR_NUM="$1"
REPO_NAME="$2"
REPO_PATH="$3"

# gh-dash commands are shell strings, so they pass RepoPath as inert hex.
# Octo invokes this script with an argument vector and continues to pass it raw.
if [[ "$REPO_PATH" == hex:* ]]; then
  REPO_PATH_HEX="${REPO_PATH#hex:}"
  if [[ ! "$REPO_PATH_HEX" =~ ^([[:xdigit:]]{2})*$ ]]; then
    echo "[agent-review] invalid encoded repository path" >&2
    exit 1
  fi
  REPO_PATH=$(printf '%s' "$REPO_PATH_HEX" | xxd -r -p)
fi

if [[ ! "$PR_NUM" =~ ^[0-9]+$ ]]; then
  echo "[agent-review] invalid PR number: $PR_NUM" >&2
  exit 1
fi

if [[ ! "$REPO_NAME" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "[agent-review] invalid repository name: $REPO_NAME" >&2
  exit 1
fi

# Ensure the repo is cloned locally under ~/github/{org}/{repo}
OWNER="${REPO_NAME%%/*}"
REPO="${REPO_NAME##*/}"
CANONICAL_REPO_PATH="$HOME/github/$OWNER/$REPO"

if ! git -C "$REPO_PATH" rev-parse --show-toplevel >/dev/null 2>&1; then
  REPO_PATH="$CANONICAL_REPO_PATH"

  if ! git -C "$REPO_PATH" rev-parse --show-toplevel >/dev/null 2>&1; then
    if [ -e "$REPO_PATH" ]; then
      echo "[agent-review] path exists but is not a git repo: $REPO_PATH" >&2
      exit 1
    fi

    mkdir -p "$HOME/github/$OWNER"
    gh repo clone "$REPO_NAME" "$REPO_PATH"
  fi
fi

# Resolve the remote whose URL names the repository selected in gh-dash/Octo.
# Do not assume origin points at the PR's target repository.
TARGET_REMOTE=""
REPO_NAME_LOWER=$(tr '[:upper:]' '[:lower:]' <<<"$REPO_NAME")
while IFS= read -r remote; do
  remote_url=$(git -C "$REPO_PATH" config --get "remote.$remote.url")
  remote_repo="$remote_url"
  if [[ "$remote_repo" == *"://"* ]]; then
    remote_repo="${remote_repo#*://}"
    remote_repo="${remote_repo#*/}"
  else
    remote_repo="${remote_repo#*:}"
  fi
  remote_repo="${remote_repo%.git}"
  remote_repo_lower=$(tr '[:upper:]' '[:lower:]' <<<"$remote_repo")

  if [ "$remote_repo_lower" = "$REPO_NAME_LOWER" ]; then
    TARGET_REMOTE="$remote"
    break
  fi
done < <(git -C "$REPO_PATH" remote)

if [ -z "$TARGET_REMOTE" ]; then
  echo "[agent-review] no Git remote matches $REPO_NAME in $REPO_PATH" >&2
  exit 1
fi

# Resolve the exact comparison range. Fetching GitHub's pull ref works for PRs
# from forks and gives us an independent ref to verify after Worktrunk setup.
# Keep this synthetic ref outside refs/remotes so the global pre-switch prune
# hook does not delete it before Worktrunk uses it as the creation base.
PR_REF="refs/opencode-pr/$PR_NUM"
IFS=$'\t' read -r BRANCH BASE_BRANCH < <(
  gh pr view "$PR_NUM" -R "$REPO_NAME" \
    --json headRefName,baseRefName \
    --jq '[.headRefName, .baseRefName] | @tsv'
)

git -C "$REPO_PATH" fetch "$TARGET_REMOTE" \
  "+refs/heads/$BASE_BRANCH:refs/remotes/$TARGET_REMOTE/$BASE_BRANCH" \
  "+refs/pull/$PR_NUM/head:$PR_REF"
HEAD_SHA=$(git -C "$REPO_PATH" rev-parse "$PR_REF")
git -C "$REPO_PATH" cat-file -e "$HEAD_SHA^{commit}"

# Use a local branch owned by this wrapper so Worktrunk can manage the full
# lifecycle without touching the contributor's PR branch.
REVIEW_BRANCH="review-pr-${PR_NUM}"
if git -C "$REPO_PATH" show-ref --verify --quiet \
  "refs/heads/$REVIEW_BRANCH"; then
  if [ "$(git -C "$REPO_PATH" config --bool --get \
    "branch.$REVIEW_BRANCH.opencode-review" || true)" != true ]; then
    echo "[agent-review] refusing to replace unowned branch: $REVIEW_BRANCH" >&2
    exit 1
  fi

  WT_RESULT=$(wt -C "$REPO_PATH" switch -y --no-cd \
    --format json "$REVIEW_BRANCH")
  WT_PATH=$(jq -er '.path' <<<"$WT_RESULT")
  SESSION_NAME=$(basename "$WT_PATH")
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    if [ "$(git -C "$WT_PATH" rev-parse HEAD)" != "$HEAD_SHA" ]; then
      echo "[agent-review] retained session is for an outdated PR head" >&2
      exit 1
    fi
    if [ -n "$(git -C "$WT_PATH" status --porcelain)" ]; then
      echo "[agent-review] retained review worktree is not clean: $WT_PATH" >&2
      exit 1
    fi
    sesh connect "$WT_PATH"
    exit 0
  fi

  # No live review owns this branch. Worktrunk refuses removal if the retained
  # worktree has changes, preserving anything unexpected for diagnosis.
  wt -C "$REPO_PATH" remove --foreground --force-delete -y "$REVIEW_BRANCH"
fi

WT_RESULT=$(wt -C "$REPO_PATH" switch --create \
  --base "$PR_REF" \
  -y --no-cd --format json "$REVIEW_BRANCH")
WT_PATH=$(jq -er '.path' <<<"$WT_RESULT")
SESSION_NAME=$(basename "$WT_PATH")
git -C "$REPO_PATH" config "branch.$REVIEW_BRANCH.opencode-review" true

if [ "$(git -C "$WT_PATH" rev-parse HEAD)" != "$HEAD_SHA" ]; then
  wt -C "$REPO_PATH" remove --foreground --force-delete -y "$REVIEW_BRANCH"
  echo "[agent-review] Worktrunk did not check out the exact PR head" >&2
  exit 1
fi

if [ -n "$(git -C "$WT_PATH" status --porcelain)" ]; then
  echo "[agent-review] review worktree is not clean: $WT_PATH" >&2
  exit 1
fi

PROMPT="Review PR #${PR_NUM} in ${REPO_NAME} from ${BRANCH} against ${TARGET_REMOTE}/${BASE_BRANCH}. Use the PR as the Spec source when it links one."
printf -v SESSION_RUNNER_ARG '%q' "$SESSION_RUNNER"
printf -v REPO_PATH_ARG '%q' "$REPO_PATH"
printf -v WT_PATH_ARG '%q' "$WT_PATH"
printf -v REVIEW_BRANCH_ARG '%q' "$REVIEW_BRANCH"
printf -v PR_REF_ARG '%q' "$PR_REF"
printf -v PROMPT_ARG '%q' "$PROMPT"
STARTUP="$SESSION_RUNNER_ARG $REPO_PATH_ARG $WT_PATH_ARG $REVIEW_BRANCH_ARG $PR_REF_ARG $PROMPT_ARG"

# Create/connect to named session (sesh handles the client switch internally)
sesh connect --command "$STARTUP" "$WT_PATH"
