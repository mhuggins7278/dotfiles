{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "scroll_acceleration": {
    "enabled": true
  },
  "keybinds": {
    "session_child_cycle": "alt+j",
    "session_child_cycle_reverse": "alt+k",
    "session_child_first": "<leader>j",
    "session_parent": "<leader>k",
    "sidebar_toggle": "<leader>b"
  }
}
