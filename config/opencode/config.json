{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "instructions": ["~/.dotfiles/config/ai/global-policy.md"],
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "You are in plan mode. You may NOT edit or write files in the codebase. When the user describes work to plan, use the `to-spec` skill to turn it into a spec GitHub issue (run a `grilling` session first if the idea hasn't been challenged yet), then use the `to-tickets` skill to break it into tracer-bullet GitHub issues — a single issue for self-contained work, or an epic with linked sub-issues for larger features. Both skills handle GitHub issue creation, GLG project tagging, and branch-naming rules directly. You ARE allowed and expected to run the GitHub CLI commands those skills specify (gh issue create, gh issue edit, gh api, gh project item-add, etc.) as part of these workflows.",
      "permission": {
        "bash": {
          "*": "ask",
          "gh repo view*": "allow",
          "gh api*": "allow",
          "gh search*": "allow",
          "gh issue*": "allow",
          "gh pr list*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh project item-add*": "allow",
          "gh auth status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git shortlog*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git remote -v*": "allow",
          "git branch --show-current*": "allow",
          "git tag --list*": "allow",
          "git tag --contains*": "allow",
          "git show-ref*": "allow",
          "git ls-remote*": "allow",
          "git rev-parse*": "allow",
          "git blame*": "allow",
          "gh release view*": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "scout": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.6-luna": {
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            }
          }
        }
      }
    },
    "github-copilot": {
      "models": {
        "gemini-3.1-pro-preview": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/github/glg/**": "allow",
      "~/github/glg/epiquery-templates/**": "allow",
      "~/github/mhuggins7278/notes/**": "allow",
      "~/.config/opencode/references/**": "allow",
      "~/.dotfiles/config/opencode/references/**": "allow",
      "~/zoom-transcripts/**": "allow",
      "/tmp/**": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "whoIs": {
      "type": "local",
      "command": ["npx", "-y", "@glg/mcp-whois"],
      "enabled": true
    },
    "gds": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/gds/mcp",
      "enabled": true
    },
    "know": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/know/mcp",
      "enabled": true
    },

    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "tools": {
    "figma*": false,
    "whoIs_*": false,
    "playwright_*": false,
    "context7_*": false,
    "gds*": false
  }
}
