{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "instructions": ["~/.dotfiles/config/ai/global-policy.md"],
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "max",
      "prompt": "You are in plan mode. You may NOT edit or write files in the codebase, but you MAY write /done session notes under ~/github/mhuggins7278/notes/**. Follow `~/.dotfiles/config/ai/playbooks/workflow.md`. When the user explicitly asks to plan work, use `grill-with-docs` only if material decisions remain unresolved; otherwise use `to-spec` to publish the resolved plan. Use `to-tickets` only after a spec exists and the work needs multiple implementation tickets. Do not restart grilling or add approval gates owned by another workflow phase. These skills handle GitHub issue creation, GLG project tagging, and branch-naming rules directly. You ARE allowed and expected to run the GitHub CLI commands they specify (gh issue create, gh issue edit, gh api, gh project item-add, etc.) as part of those workflows.",
      "permission": {
        "edit": {
          "*": "deny",
          "~/github/mhuggins7278/notes/**": "allow"
        },
        "bash": {
          "*": "ask",
          "gh repo view*": "allow",
          "gh api*": "allow",
          "gh search*": "allow",
          "gh issue*": "allow",
          "gh pr list*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh project item-add*": "allow",
          "gh auth status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git shortlog*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git remote -v*": "allow",
          "git branch --show-current*": "allow",
          "git tag --list*": "allow",
          "git tag --contains*": "allow",
          "git show-ref*": "allow",
          "git ls-remote*": "allow",
          "git rev-parse*": "allow",
          "git blame*": "allow",
          "gh release view*": "allow",
          "observe-glg *": "allow",
          "jq *": "allow",
          "wc *": "allow",
          "tr *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "head *": "allow",
          "basename *": "allow",
          "echo *": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "scout": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.6-luna": {
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    },
    "github-copilot": {
      "models": {
        "gemini-3.1-pro-preview": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/github/glg/**": "allow",
      "~/github/glg/epiquery-templates/**": "allow",
      "~/github/mhuggins7278/notes/**": "allow",
      "~/github/quickvet-dash/**": "allow",
      "~/.dotfiles/config/ai/playbooks/**": "allow",
      "~/.config/opencode/references/**": "allow",
      "~/.dotfiles/config/opencode/references/**": "allow",
      "~/.dotfiles/config/opencode/scripts/**": "allow",
      "~/zoom-transcripts/**": "allow",
      "/tmp/**": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "whoIs": {
      "type": "local",
      "command": ["npx", "-y", "@glg/mcp-whois"],
      "enabled": true
    },
    "gds": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/gds/mcp",
      "enabled": true
    },
    "know": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/know/mcp",
      "enabled": true
    },

    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "tools": {
    "figma*": false,
    "whoIs_*": false,
    "playwright_*": false,
    "context7_*": false,
    "gds*": false
  }
}
