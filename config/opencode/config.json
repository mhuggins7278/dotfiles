{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "instructions": ["~/.dotfiles/config/ai/global-policy.md"],
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "max",
      "prompt": "You are in plan mode. Inspect the codebase and produce a concise, actionable plan. Do not edit project files or mutate GitHub. Ask only when a decision materially changes behavior, architecture, safety, privacy, or cost; otherwise state reasonable assumptions and proceed. Use `~/.dotfiles/config/ai/playbooks/workflow.md` as proportional guidance, not a mandatory phase sequence. You may write session notes under ~/github/mhuggins7278/notes/** only when the user invokes /done.",
      "permission": {
        "edit": {
          "*": "deny",
          "~/github/mhuggins7278/notes/**": "allow"
        },
        "bash": {
          "*": "ask",
          "gh repo view*": "allow",
          "gh search*": "allow",
          "gh issue list*": "allow",
          "gh issue view*": "allow",
          "gh pr list*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh auth status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git shortlog*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git remote -v*": "allow",
          "git branch --show-current*": "allow",
          "git tag --list*": "allow",
          "git tag --contains*": "allow",
          "git show-ref*": "allow",
          "git ls-remote*": "allow",
          "git rev-parse*": "allow",
          "git blame*": "allow",
          "gh release view*": "allow",
          "observe-glg *": "allow",
          "jq *": "allow",
          "wc *": "allow",
          "tr *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "head *": "allow",
          "basename *": "allow",
          "echo *": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.6-luna": {
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    },
    "github-copilot": {
      "models": {
        "gemini-3.1-pro-preview": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git checkout --*": "ask",
      "git restore*": "ask",
      "git branch -D*": "ask",
      "gh api*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue reopen*": "ask",
      "gh issue comment*": "ask",
      "gh pr create*": "ask",
      "gh pr edit*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr reopen*": "ask",
      "gh pr review*": "ask",
      "gh release create*": "ask",
      "gh release edit*": "ask",
      "gh release delete*": "ask",
      "gh release upload*": "ask",
      "gh project item-add*": "ask"
    },
    "external_directory": {
      "~/github/glg/**": "allow",
      "~/github/glg/epiquery-templates/**": "allow",
      "~/github/mhuggins7278/notes/**": "allow",
      "~/github/quickvet-dash/**": "allow",
      "~/.dotfiles/config/ai/playbooks/**": "allow",
      "~/.config/opencode/references/**": "allow",
      "~/.dotfiles/config/opencode/references/**": "allow",
      "~/.dotfiles/config/opencode/scripts/**": "allow",
      "~/zoom-transcripts/**": "allow",
      "/tmp/**": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "figma*": "deny",
    "whoIs_*": "deny",
    "context7_*": "deny",
    "gds*": "deny"
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "whoIs": {
      "type": "local",
      "command": ["npx", "-y", "@glg/mcp-whois"],
      "enabled": true
    },
    "gds": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/gds/mcp",
      "enabled": true
    },
    "know": {
      "type": "remote",
      "url": "https://mcp.glgresearch.com/know/mcp",
      "enabled": true
    },

    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
