{
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "session.sidebar.toggle": "<leader>b",
    "session.child.first": "<leader>j",
    "session.parent": "<leader>k",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true
}
